        ],
        "dimension": "world",
        "summary": "让狼人的身体、群体秩序与归属规则改变选择；本能、亲密关系和自主权之间的冲突带来代价与回报。",
        "applicability": {
          "readers": [],
          "markets": [],
          "languages": [],
          "lengths": []
        },
        "reader_promises": [
          {
            "id": "promise_01",
            "text": "读者看见只有在狼人世界才成立的困境，而非将普通豪门故事中的称呼换成 Alpha。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          },
          {
            "id": "promise_02",
            "text": "力量带来能力与限制，归属带来保护与义务；人物在两种有价值但不能兼得的事物之间选择。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          },
          {
            "id": "promise_03",
            "text": "感情发展由具体行动、信任和边界支撑；伴侣牵引可以造成压力，但不等于同意、爱情或注定的结局。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          }
        ],
        "mechanisms": [
          {
            "id": "wolf_body",
            "name": "能力与失控的双刃",
            "principle": "先选本书的一项关键能力及其代价，设计它如何帮助人物、又如何迫使人物承担后果。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ],
            "trigger": [
              "月相、威胁、感官刺激或自主变形择一设定；不默认所有狼人规则都存在。"
            ],
            "scope": [],
            "limits": [
              "明确恢复时间、感官盲区、力量上限和信息来源；新增例外须提前铺垫。"
            ],
            "exceptions": [],
            "costs": [
              "暴露身份、失去判断、体力透支或伤及信任应有可见且持续的后果。"
            ],
            "choices": [
              "为保护某人使用能力并暴露弱点，还是保守秘密而承担另一种损失？"
            ],
            "payoffs": [
              "高潮用已经建立的限制与训练解决问题；胜利不能靠临时血统升级。"
            ]
          },
          {
            "id": "wolf_belonging",
            "name": "归属与自治的交换",
            "principle": "群体提供真实利益，也索取义务；设计能诱惑主角留下的好处与不能接受的条件。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ],
            "trigger": [
              "继承、迁徙、庇护、领地危机或群体承诺被触发。"
            ],
            "scope": [],
            "limits": [
              "先明确谁有权制定、执行与挑战规则，个人反对不自动让制度失效。"
            ],
            "exceptions": [],
            "costs": [
              "失去庇护、人际信誉或共同资源；盟友也有自己的风险。"
            ],
            "choices": [
              "服从以保护重要之人、谈判改变规则、付出代价离开，或建立新的合作关系。"
            ],
            "payoffs": [
              "前期的小型互助与兑现积累成后期的联盟能力，不靠全体突然臣服。"
            ]
          },
          {
            "id": "wolf_bond",
            "name": "可选：牵引与自由选择",
            "principle": "只有作者选择伴侣机制时采用；让被感知的牵引与真实关系表现形成张力。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ],
            "trigger": [
              "确认本书如何辨认牵引，以及它是否可能被误读。"
            ],
            "scope": [],
            "limits": [
              "不把气味、命定或占有欲当作道德证明；不能越过个人同意。"
            ],
            "exceptions": [],
            "costs": [
              "拒绝、维持或重新协商关系各有情感与群体代价，不能只有一种被惩罚。"
            ],
            "choices": [
              "本能、责任与真正信任不一致时，人物依据谁的行为作出选择？"
            ],
            "payoffs": [
              "最终亲密关系由多次具体选择积累，允许选择独身或非命定关系。"
            ]
          }
        ],
        "character_dynamics": [
          {
            "id": "character_01",
            "text": "主角有超出恋爱资格的具体目标；对手既有欲望也有方法，盟友不可只作血统证明或临时救援。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          },
          {
            "id": "character_02",
            "text": "可从能力伦理、群体生存、继承秩序或亲密关系中选不同主轴；不要把每一本都写成被拒绝的弱者成为隐藏王族。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          }
        ],
        "voice_guidance": [
          {
            "id": "voice_01",
            "text": "嗅觉、听觉和变形经验通过当下判断与行动进入叙述；避免每段重复兽性、低吼或专属称谓。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          },
          {
            "id": "voice_02",
            "text": "危机场景紧凑，关系场景允许犹疑、潜台词与余波；人物声音由经历和权力位置区分。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          }
        ],
        "pitfalls": [
          {
            "id": "pitfall_01",
            "text": "不默认狼人等于男性控制、女性顺从；不把强迫关系包装为无需讨论的命运。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          },
          {
            "id": "pitfall_02",
            "text": "不靠最后突然出现的王族身份、万能伴侣或无代价复活解决主冲突。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "draft",
              "review"
            ]
          }
        ],
        "diagnostics": [
          {
            "id": "diagnostic_01",
            "text": "移除题材机制后，主要选择和高潮是否仍完全相同？若是，讨论让题材真正改变因果的方案，不靠增加术语补救。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "review"
            ]
          },
          {
            "id": "diagnostic_02",
            "text": "转折能否回看出依据？人物是否根据自己知道的信息行动？反对者是否会调整策略，而不是等待主角获胜？",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "review"
            ]
          },
          {
            "id": "diagnostic_03",
            "text": "已有承诺是否获得阶段回报？安静场景可通过理解、信任或边界的改变提供价值，不要求每章争吵或反转。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "review"
            ]
          },
          {
            "id": "diagnostic_04",
            "text": "同题材的新方案应在目标、权力关系、规则、对抗来源、代价、揭示路径、终局选择中至少改变三项；说明改变后的因果差异，不能只换名字职业。保留作者已锁定的设定。",
            "importance": "recommended",
            "stages": [
              "brainstorm",
              "story_design",
              "chapter_plan",
              "review"
            ]
          },
          {
            "id": "diagnostic_05",
            "text": "先给出两到三个不同故事走线及取舍，再推荐本书下一步关键选择。只追问最影响故事的一两点；不擅自把备选设定写成已确认事实。",
            "importance": "recommended",
            "stages": [
              "brainstorm"
            ]
          }
