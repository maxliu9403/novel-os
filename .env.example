# ============================================================
#  Novel OS pick ONE provider. Auto-detected from key presence,
#  or set NOVEL_OS_LLM_PROVIDER explicitly. Studio Settings is
#  preferred; these variables remain supported for headless use.
# ============================================================

# --- Codex login (text + gpt-image-2; no copied API key) ---
# Install Codex, run `codex login`, then select Codex in Studio Settings.
# NOVEL_OS_LLM_PROVIDER=codex

# Brainstorming uses the separate workshop text route in Studio Settings.
# Long replies run as background jobs; failed turns keep the previous skeleton.
NOVEL_OS_WORKSHOP_TIMEOUT_SECONDS=900
# NOVEL_OS_MODEL=

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# NOVEL_OS_MODEL=claude-sonnet-4-6

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# NOVEL_OS_MODEL=gpt-4o

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# NOVEL_OS_LLM_PROVIDER=azure
# NOVEL_OS_MODEL=your-deployment-name

# --- Google Gemini ---
# GEMINI_API_KEY=...
# NOVEL_OS_MODEL=gemini-2.0-flash

# --- Kimi / Moonshot ---
# KIMI_API_KEY=...
# NOVEL_OS_LLM_PROVIDER=kimi
# NOVEL_OS_MODEL=kimi-k2-0905-preview
# KIMI_BASE_URL=https://api.moonshot.ai/v1   # use https://api.moonshot.cn/v1 from China

# --- Other OpenAI-compatible providers (just set the key) ---
# GROQ_API_KEY=...           NOVEL_OS_LLM_PROVIDER=groq
# TOGETHER_API_KEY=...       NOVEL_OS_LLM_PROVIDER=together
# OPENROUTER_API_KEY=...     NOVEL_OS_LLM_PROVIDER=openrouter
# DEEPSEEK_API_KEY=...       NOVEL_OS_LLM_PROVIDER=deepseek
# MISTRAL_API_KEY=...        NOVEL_OS_LLM_PROVIDER=mistral
# FIREWORKS_API_KEY=...      NOVEL_OS_LLM_PROVIDER=fireworks
# NVIDIA_API_KEY=...         NOVEL_OS_LLM_PROVIDER=nvidia
# NOVEL_OS_MODEL=meta/llama-3.3-70b-instruct   # or nvidia/llama-3.3-nemotron-super-49b-v1

# --- Local servers (Ollama / LM Studio / vLLM) ---
# NOVEL_OS_LLM_PROVIDER=ollama
# NOVEL_OS_MODEL=llama3.2

# --- ANY OpenAI-compatible endpoint (custom) ---
# This works with gateways that implement the OpenAI API shape.
# NOVEL_OS_LLM_PROVIDER=openai_compatible
# NOVEL_OS_BASE_URL=https://your-endpoint/v1
# NOVEL_OS_API_KEY=...
# NOVEL_OS_MODEL=your-model-id

# --- Legacy/headless cover configuration (OpenAI-compatible Images API) ---
# Empty URL/key values reuse NOVEL_OS_BASE_URL and NOVEL_OS_API_KEY above.
# NOVEL_OS_COVER_BASE_URL=https://your-endpoint/v1
# NOVEL_OS_COVER_API_KEY=...
NOVEL_OS_COVER_MODEL=gpt-image-2
NOVEL_OS_COVER_SIZE=2048x3072
NOVEL_OS_COVER_QUALITY=high
NOVEL_OS_COVER_FORMAT=jpeg
NOVEL_OS_COVER_COUNT=4
NOVEL_OS_COVER_TIMEOUT_SECONDS=300
# Optional. Empty Director values reuse the writing provider, model, URL, and key.
# NOVEL_OS_COVER_DIRECTOR_PROVIDER=openai_compatible
# NOVEL_OS_COVER_DIRECTOR_MODEL=your-planning-model
# NOVEL_OS_COVER_DIRECTOR_BASE_URL=https://your-text-endpoint/v1
# NOVEL_OS_COVER_DIRECTOR_API_KEY=...
NOVEL_OS_COVER_DIRECTOR_TIMEOUT_SECONDS=600
NOVEL_OS_COVER_DIRECTOR_REASONING_EFFORT=medium

# --- API database (SQLModel). Story manuscripts stay on the filesystem. ---
# NOVEL_OS_DB=sqlite:///./novel_os.db
# Hosted: postgresql+psycopg://user:pass@localhost:5432/novel_os

# --- Docker deployment ---
# NOVEL_OS_WEB_PORT=5174
# NOVEL_OS_DATA_DIR=./docker-data
# The current Compose setup requires both Codex files to exist before startup.
# Optional when Codex login files live outside $HOME/.codex:
# NOVEL_OS_CODEX_AUTH_FILE=/path/to/codex/auth.json
# NOVEL_OS_CODEX_CONFIG_FILE=/path/to/codex/config.toml
